{
  "name": "ink-motion",
  "type": "module",
  "version": "1.0.4",
  "description": "Motion and animation components for Ink - beautiful text effects for your CLI",
  "author": "James Glenn",
  "license": "MIT",
  "homepage": "https://github.com/JR-G/ink-motion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JR-G/ink-motion.git"
  },
  "bugs": {
    "url": "https://github.com/JR-G/ink-motion/issues"
  },
  "keywords": [
    "ink",
    "cli",
    "terminal",
    "animation",
    "motion",
    "text-effects",
    "react",
    "shimmer",
    "typewriter",
    "fade",
    "wave",
    "flash",
    "neon"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "demo": "bun examples/demo.tsx",
    "test": "bun test",
    "test:file": "f() { bun test tests/${1:-*}.test.tsx; }; f",
    "test:all": "bun run lint && bun run type-check && bun run test && bun run build",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "hooks:install": "lefthook install --reset-hooks-path",
    "hooks:run:pre-push": "lefthook run pre-push",
    "release": "bash scripts/release.sh",
    "release:tag": "bash scripts/release-tag.sh",
    "prepublishOnly": "bun run build && publint"
  },
  "peerDependencies": {
    "ink": "^5.0.0",
    "react": "^18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.2",
    "@eslint-react/eslint-plugin": "^2.12.4",
    "@types/bun": "latest",
    "@types/react": "^19.2.13",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "ink": "^6.7.0",
    "ink-testing-library": "^4.0.0",
    "lefthook": "^2.1.0",
    "publint": "^0.3.17",
    "react": "^19.2.4",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
